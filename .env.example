# --- Datenbank Konfiguration ---
# Diese Werte werden vom Postgres-Container beim Start genutzt
POSTGRES_USER=deng
POSTGRES_PASSWORD=deng_dev_password
POSTGRES_DB=deng

# --- Pipeline Konfiguration ---
# WICHTIG: 'postgres' ist der Name des Services in der compose.yaml
# Port 5432 ist der interne Container-Port
DATABASE_URL=postgresql://deng:deng_dev_password@postgres:5432/deng

# --- Kaggle API ---
KAGGLE_API_TOKEN=

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# --- Airflow Spezifisch ---
AIRFLOW_UID=50000
# Wir sagen Airflow, dass es seine Metadaten-Tabelle in derselben DB speichern soll
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://deng:deng_dev_password@postgres:5432/deng
# Verhindert, dass Airflow beim ersten Start Beispiel-DAGs lädt (macht es übersichtlicher)
AIRFLOW__CORE__LOAD_EXAMPLES=False


# --- Cloud Pipeline Konfiguration (Person 1 & 2) ---
# Die Projekt-ID eures Google Cloud Projekts
GCP_PROJECT_ID=deng-team2-bike-sharing
# Die Region (z.B. europe-west6 für Zürich)
GCP_REGION=europe-west6
# Der global eindeutige Name des Google Cloud Storage Buckets
GCS_BUCKET_NAME=deng-team2-bike-sharing-data-lake
# Name des BigQuery Datasets
BQ_DATASET=bike_sharing
# Der Pfad zur Service-Account-JSON innerhalb des Airflow-Containers (so lassen!)
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/gcp/service-account.json